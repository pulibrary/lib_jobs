      "type": "scopecontent",
      "subnotes": [
        {
          "jsonmodel_type": "note_text",
          "content": "A manuscript account of the hacienda of San José de Acolman and other properties in Mexico which were confiscated from the Jesuits, as part of the 1767 general expulsion by Charles III. The title page reads, \"Testimonio del quaderno quinto de las\ndiligencias... con arreglamiento a las superiores ordenes sobre la confiscación de las\ntemporalidades de los Religiosos de la Sagrada Compañıá de Jesús en las haciendas de San Joseph de Acolman.\"",
          "publish": true
        }
      ],
      "publish": true
    }

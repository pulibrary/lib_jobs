            "persistent_id": "a4d88121bbb9758c303e77dd67679c37",
            "subnotes": [
              {
                "jsonmodel_type": "note_text",
                "content": "The National Freedman's Relief Association was founded in 1862, and headquartered in New York City. The association's mission was to provide relief to the millions of enslaved people in the southern United States emancipated during and following the American Civil War. The National Freedman's Relief Association supplied emancipated peoples with housing, food, and clothing. They built schools to educate both Black children and adults, and erected industrial schools to teach skills such as garment-making. The National Freedman's Relief Association was the precursor to the federal Bureau of Refugees, Freedmen, and Abandoned Lands. ",
                "publish": false
              }
            ],
            "publish": false
